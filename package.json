{
  "name": "capsid-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Capsid: a Cloudflare-native MCP server serving a consolidated knowledge base from D1 and R2",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "check": "tsc --noEmit",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import ./test/resolve-ts.mjs --test \"test/*.test.ts\"",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "24.13.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.3",
    "zod": "^4.4.3"
  }
}
